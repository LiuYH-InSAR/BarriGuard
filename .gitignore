# Local development and generated runtime data never go to GitHub.
/tmp/
/training/
/output/
/data/
/evidence/
/logs/
/Ultralytics/
__pycache__/
*.py[cod]
.venv*/
*.egg-info/
build/
dist/
.env
.env.*
!.env.example
deploy/.env
deploy/.env.*
!deploy/.env.example
deploy/config.local.yaml

# Only the selected runtime model is versioned; no other training weights.
*.pt
*.onnx
*.engine
!models/water_barrier_v6/best.pt

# No archive-based release workflow.
*.zip
*.tar.gz
*.tar.xz
